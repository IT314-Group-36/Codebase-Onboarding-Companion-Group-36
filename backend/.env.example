# --- LLM (module map description, repo summary, /ask, impact explanation) ---
# Built with LangChain: LLM_MODEL is "<provider>:<model>". To use another provider, set LLM_MODEL
# (e.g. openai:gpt-5) and install that provider's package (uv add langchain-openai). Nothing else changes.
# Free Gemini key from Google AI Studio. Without a key the app still works: it falls back to a
# deterministic module map and /ask returns 503.
LLM_API_KEY=your_key_here          # the old name GOOGLE_API_KEY is still accepted
LLM_MODEL=google_genai:gemini-3.6-flash
# Spacing between LLM calls in seconds (free-tier per-minute limits). Lower it on a paid plan.
LLM_MIN_INTERVAL_SECONDS=4

# --- infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://onboard:onboard@localhost:5432/onboard
REDIS_URL=redis://localhost:6379

# --- embeddings (free, local, no torch; LangChain Embeddings interface) ---
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --- GitHub login + private repos (needed once the login endpoints are enabled) ---
# 1. Generate the two secrets below:   docker compose run --rm api python -m app.core.security
#    (or locally:  cd backend && uv run python -m app.core.security)   Keep them private, never commit .env.
# 2. Create an OAuth app at https://github.com/settings/developers  (New OAuth App) with
#    Authorization callback URL = http://localhost:5173/api/auth/github/callback
TOKEN_ENCRYPTION_KEY=          # encrypts stored GitHub tokens (Fernet key). Comma-separate several keys to rotate.
SESSION_SECRET=                # signs the login cookie, at least 32 characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback   # default; must equal the OAuth app's callback URL
# FRONTEND_URL=http://localhost:5173                                    # default; where users land after login
# COOKIE_SECURE=true                                                    # turn on when served over https
