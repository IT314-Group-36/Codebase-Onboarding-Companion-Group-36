# --- LLM (module map description, repo summary, /ask, impact explanation) ---
# Built with LangChain: LLM_MODEL is "<provider>:<model>". To use another provider, set LLM_MODEL
# (e.g. openai:gpt-5) and install that provider's package (uv add langchain-openai). Nothing else changes.
# Free Gemini key from Google AI Studio. Without a key the app still works: it falls back to a
# deterministic module map and /ask returns 503.
LLM_API_KEY=your_key_here          # the old name GOOGLE_API_KEY is still accepted
LLM_MODEL=google_genai:gemini-3.6-flash
# Spacing between LLM calls in seconds (free-tier per-minute limits). Lower it on a paid plan.
LLM_MIN_INTERVAL_SECONDS=4

# --- infrastructure (defaults match docker-compose.yml) ---
# Hosted Postgres (Neon, Render, ...): paste the connection string exactly as the host gives it. A plain
# postgresql:// or postgres:// prefix is converted automatically, and Neon URLs get sslmode=require.
# Use Neon's DIRECT connection string (not the "-pooler" one) unless you know you need the pooler.
DATABASE_URL=postgresql+psycopg://onboard:onboard@localhost:5432/onboard

# --- embeddings: Cloudflare Workers AI (hosted bge-small, 384 dims, free daily allowance, no card) ---
# Dashboard -> AI -> Workers AI -> "Use REST API": copy the Account ID and create an API token (Workers AI permission).
# Check the current free allowance and pricing on Cloudflare's Workers AI pricing page.
EMBED_BACKEND=cloudflare
EMBED_MODEL=@cf/baai/bge-small-en-v1.5
EMBED_DIM=384                  # must match the migrated vector column
CF_ACCOUNT_ID=
CF_API_TOKEN=
EMBED_BATCH_SIZE=128           # chunks per progress step
EMBED_CF_BATCH_SIZE=50         # texts per Cloudflare request (max 100)
EMBED_CF_CONCURRENCY=4         # requests in flight at once

# --- GitHub sign-in (required: the app is behind GitHub login; also enables private repos) ---
# 1. Generate the two secrets below:   docker compose run --rm api python -m app.core.security
#    (or locally:  cd backend && uv run python -m app.core.security)   Keep them private, never commit .env.
# 2. Create an OAuth app at https://github.com/settings/developers  (New OAuth App) with
#    Authorization callback URL = http://localhost:5173/api/auth/github/callback
TOKEN_ENCRYPTION_KEY=          # encrypts stored GitHub tokens (Fernet key). Comma-separate several keys to rotate.
SESSION_SECRET=                # signs the login cookie, at least 32 characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback   # default; must equal the OAuth app's callback URL
# FRONTEND_URL=http://localhost:5173                                    # default; where users land after login
# COOKIE_SECURE=true                                                    # turn on when served over https

# --- optional tuning (defaults shown; uncomment to change) ---
# Background jobs run inside the API process (no Redis, no worker). Indexing is memory-heavy, so it runs one
# repository at a time by default; raise this only on a host with plenty of RAM.
# MAX_CONCURRENT_INDEXING=1
# JOB_TIMEOUT_SECONDS=1800         # a background job running longer than this is marked failed
# DB_POOL_SIZE=5                   # keep small on free Postgres hosts (they cap connections)
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE_SECONDS=300      # replace pooled connections before the host closes them when idle
# DB_CONNECT_TIMEOUT_SECONDS=30    # a sleeping Neon database needs a few seconds to wake up
# MAX_CHUNKS=5000                  # cap on indexed chunks per repository
# MAX_FILE_BYTES=200000            # larger source files are skipped
# MAX_CLONE_BYTES=209715200        # 200 MiB clone+checkout disk watchdog budget; checked during Git operations
# MAX_CHECKOUT_BYTES=104857600     # reject expanded trees over 100 MiB BEFORE checkout
# MAX_CLONE_FILE_BYTES=20971520    # reject individual blobs over 20 MiB BEFORE checkout
# CLONE_MEMORY_BYTES=268435456     # 256 MiB hard per-process address-space cap (Linux)
# CLONE_CPU_SECONDS=120            # hard per-process CPU cap (Linux)
# CLONE_TIMEOUT_SECONDS=300        # wall-clock deadline shared by clone, inspection and checkout
# CLONE_MIN_FREE_DISK_BYTES=268435456  # stop if the work filesystem has less than 256 MiB free
# EMBED_CF_POOLING=cls             # keep "cls": the pooling bge-small was trained with
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=4
# CORS_ORIGINS=["http://localhost:5173"]
# SESSION_COOKIE_NAME=session
# SESSION_TTL_SECONDS=604800       # 7 days
# GITHUB_TOKEN=                    # optional server token for the GitHub issues sync (raises the API rate limit)
# GITHUB_API_URL=https://api.github.com
# ISSUE_LABELS=["good first issue","good-first-issue","beginner","help wanted"]   # labels treated as starter tasks
# ISSUE_MAX_PAGES=3                # pages of open issues read per sync
# ISSUE_TIMEOUT_SECONDS=15
# WORK_DIR=/tmp/onboarding_work    # where repositories are cloned temporarily
# --- abuse protection (defaults shown): per-user limits and quotas that protect the free tiers ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LLM_PER_MINUTE=10     # shared: Q&A, uncached/refreshed explanations, impact/task AI options
# RATE_LIMIT_LLM_PER_HOUR=100
# RATE_LIMIT_READ_PER_MINUTE=60    # /search, /explain, /impact, /onboarding-tasks
# RATE_LIMIT_INDEX_PER_HOUR=10     # adding, re-indexing and issue-sync requests
# RATE_LIMIT_REFRESH_PER_HOUR=5    # extra refresh-request budget; explanation generation also uses AI quota
# RATE_LIMIT_WRITE_PER_MINUTE=60  # progress writes and chat create/delete, per signed-in user
# MAX_REPOS_PER_USER=5
# MAX_ACTIVE_JOBS_PER_USER=2       # repositories queued or indexing at the same time, per user
# MAX_TOTAL_CHUNKS=60000           # all users together; about 270 MB of the Neon free tier
# MAX_TASK_PROGRESS_PER_REPO=200
# MAX_TOTAL_TASK_PROGRESS=20000
# MAX_CONVERSATIONS_PER_REPO=20
# MAX_CONVERSATIONS_PER_USER=100
# MAX_TOTAL_CONVERSATIONS=5000
# MAX_MESSAGES_PER_CONVERSATION=100  # each streamed turn reserves TWO rows (question + answer)
# MAX_MESSAGES_PER_USER=2000
# MAX_TOTAL_MESSAGES=20000
# MAX_MESSAGE_CONTENT_BYTES=32000   # UTF-8 byte cap; oversized answers stop and are marked failed
# MAX_MESSAGE_CITATIONS_BYTES=8192
# CONVERSATION_STREAM_TIMEOUT_SECONDS=120
# STORAGE_BUDGET_BYTES=419430400    # 400 MiB planning budget for chunks, progress, chats, reserved messages
# STORAGE_CHUNK_BYTES=6000          # minimum allowance per chunk; larger payloads count at their larger estimate
# ALLOW_LOCAL_REPOS=false          # tests / local demos only: lets the indexer clone a local path
