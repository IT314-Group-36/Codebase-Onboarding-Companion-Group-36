# --- LLM (module map description, repo summary, /ask, impact explanation) ---
# Built with LangChain: LLM_MODEL is "<provider>:<model>". To use another provider, set LLM_MODEL
# (e.g. openai:gpt-5) and install that provider's package (uv add langchain-openai). Nothing else changes.
# Free Gemini key from Google AI Studio. Without a key the app still works: it falls back to a
# deterministic module map and /ask returns 503.
LLM_API_KEY=your_key_here          # the old name GOOGLE_API_KEY is still accepted
LLM_MODEL=google_genai:gemini-3.6-flash
# Spacing between LLM calls in seconds (free-tier per-minute limits). Lower it on a paid plan.
LLM_MIN_INTERVAL_SECONDS=4

# --- infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://onboard:onboard@localhost:5432/onboard
REDIS_URL=redis://localhost:6379

# --- embeddings (free, local, no torch; LangChain Embeddings interface) ---
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
